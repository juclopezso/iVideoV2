# Theme: iCamVideo
# By: Humberto Santana (humbertosantana@hotmail.com)
# License: Creative Commons Attribution-Share Alike 3.0 (http://creativecommons.org/licenses/by-sa/3.0/)
# Derived from iLike Theme for 320x240 by Alan Brito, which was ported from the 176x132 version by H. Pearce
# If used for other works, as per this license, please include the following Attribution Text: "Modified/Derived from iVideo theme for iPod Video (CC-BY-SA 3.0) by Humberto Santana"
# Sorry for the mess in the code, the base theme wasn't commented and I was too lazy to do it.
#
# Version 1.2
# Last Update: February 22nd, 2011
# First Version: February 8th, 2011
#
# SBS File
#
%T(0,0,50,24,select)
%T(0,0,50,24,&cancel)
%T(60,0,200,24,menu)
%T(60,0,200,24,&cancel)
%wd
%Fl(2,18 iLike.fnt)
%Fl(3,12-Adobe-Helvetica-Bold.fnt,12)
%xl(A,Battery Icon.bmp,0,0,25)
%xl(B,Disk Access.bmp,0,0,6)
%xl(C,Hold Icon.bmp,0,0)
%xl(D,Playmode Icon.bmp,0,0,4)
# Album art (right-half now-playing panel, see below)
%Cl(0,0,216,216,c,c)
%?St(battery display)<%?cs<%Vd(t)|%Vd(n)|%Vd(n)|%Vd(n)|%Vd(n)>|%?cs<%Vd(tbat)|%Vd(nbat)|%Vd(nbat)|%Vd(nbat)|%Vd(nbat)>%Vd(battery)>
# Only shrink the list + show the art panel while art exists and a track is
# playing/paused/seeking (%mp branches 2-5); full-width list otherwise. Must
# stay up here, before any %Vl/%Vi is declared below, or it gets swallowed as
# hidden content of whichever labeled viewport comes right before it and
# never runs.
%?C<%?mp<%VI(full)|%VI(half)%Vd(aa)|%VI(half)%Vd(aa)|%VI(half)%Vd(aa)|%VI(half)%Vd(aa)|%VI(full)|%VI(full)|%VI(full)|%VI(full)>|%VI(full)>
%Vl(n,53,4,214,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?cs<||%?Rp<%Sx(Recording)>|%?tp<%Sx(FM Radio)>|%Sx(Playlist)>
%Vl(t,53,4,214,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?if(%Li, =, 0)<|%?if(%Li, <=, 32)<%Lt|%?if(%Li, =, 33)<%?if(%Tp, =, 1)<Cowon D2|iPod>|>>>
%?cs<%Vd(t)|%Vd(n)|%Vd(n)|%Vd(n)|%Vd(n)>
%Vl(nbat,60,4,200,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?cs<||%?Rp<%Sx(Recording)>|%?tp<%Sx(FM Radio)>|%Sx(Playlist)>
%Vl(tbat,60,4,200,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?if(%Li, =, 0)<|%?if(%Li, <=, 32)<%Lt|%?if(%Li, =, 33)<%?if(%Tp, =, 1)<Cowon D2|iPod>|>>>
%?lh<%Vd(a)|%Vd(b)>
%Vl(battery,260,6,26,12,3)%Vf(000000)%Vb(FFFFFF)
%ac%bl%%
%Vl(b,36,5,10,13,-)%Vf(000000)%Vb(FFFFFF)
%?mh<%xd(C)|%?mr<%xd(C)>>
%Vi(-,0,24,320,216,1)%Vf(000000)%Vb(FFFFFF)
# Two extra named UI (list) viewports so the list width can be switched at
# runtime via %VI. %VI cannot be given "-" (parser rejects a default/dash
# argument for this tag), so "full" duplicates the geometry of the "-"
# viewport above (which only exists to satisfy Rockbox's own bootstrap
# requirement that a default-labelled info-viewport be present).
%Vi(full,0,24,320,216,1)%Vf(000000)%Vb(FFFFFF)
%Vi(half,0,24,160,216,1)%Vf(000000)%Vb(FFFFFF)
# Right-half now-playing album art panel: 216x216 art cropped into a 160x216
# slot (fills height, crops left/right) so it always reaches the screen edges
%Vl(aa,160,24,160,216,-)
%Cd
%Vl(a,36,4,16,16,-)%Vf(000000)%Vb(FFFFFF)
%t(0.1)%xd(Ba);%t(0.1)%xd(Bb);%t(0.1)%xd(Bc);%t(0.1)%xd(Bd);%t(0.1)%xd(Be);%t(0.1)%xd(Bf)
%V(286,6,25,12,-)%Vf(000000)%Vb(FFFFFF)
%?bp<%?bc<%t(1.0)%xd(Aa);%t(1.0)%xd(Ab)|%xd(Ac)>|%?bl<%xd(Ad)|%xd(Ad)|%xd(Ae)|%xd(Af)|%xd(Ag)|%xd(Ah)|%xd(Ai)|%xd(Aj)|%xd(Ak)|%xd(Al)|%xd(Am)|%xd(An)|%xd(Ao)|%xd(Ap)|%xd(Aq)|%xd(Ar)|%xd(As)|%xd(At)|%xd(Au)|%xd(Av)|%xd(Aw)|%xd(Ax)|%xd(Ay)>>
%V(11,4,18,15,-)%Vf(000000)%Vb(FFFFFF)
%?mp<|%xd(Da)|%xd(Db)|%xd(Dc)|%xd(Dd)|%?Rp<%xd(Da)>|%?Rp<%xd(Db)>|%?tp<%xd(Da)>|%?tp<%xd(Db)>>